# Copy to .env at the repo root. Used by the backend (run from backend/) and by docker compose.
# The frontend has its own file: frontend/.env.example.

# --- Postgres container (docker compose) ---
# LOCAL DEVELOPMENT ONLY. "rental" is a throwaway password for a database that only
# listens on your own machine. Never reuse it anywhere else. Hosted environments
# (Render) get DATABASE_URL from the provider; no credentials are stored in this repo.
POSTGRES_USER=rental
POSTGRES_PASSWORD=rental
POSTGRES_DB=rental_desk

# --- Backend ---
# Used when the backend runs on your machine against the compose database.
# (Inside compose, the backend service builds its own URL pointing at the `db` host.)
DATABASE_URL=postgresql+psycopg://rental:rental@localhost:5432/rental_desk
# Comma-separated browser origins allowed by CORS: Vite dev server and the compose frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
