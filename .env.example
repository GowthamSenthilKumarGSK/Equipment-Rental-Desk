# Copy to .env at the repo root. Used by the backend (run from backend/) and by docker compose.
# The frontend has its own file: frontend/.env.example.

# --- Postgres container (docker compose) ---
# LOCAL DEVELOPMENT ONLY. "rental" is a throwaway password for a database that only
# listens on your own machine. Never reuse it anywhere else. Hosted environments
# (Render) get DATABASE_URL from the provider; no credentials are stored in this repo.
POSTGRES_USER=rental
POSTGRES_PASSWORD=rental
POSTGRES_DB=rental_desk

# --- Backend ---
# Used when the backend runs on your machine against the compose database.
# (Inside compose, the backend service builds its own URL pointing at the `db` host.)
DATABASE_URL=postgresql+psycopg://rental:rental@localhost:5432/rental_desk
# Comma-separated browser origins allowed by CORS: Vite dev server and the compose frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
# Reviewer test clock: when true, requests may send an X-Test-Clock header to set "now".
ALLOW_TEST_CLOCK=true
# Read by the container start-up (`python -m app.serve`, used by docker compose and Render): after
# migrating, load the sample data if, and only if, the database is empty. It never resets anything;
# wiping and re-seeding is the separate, manual `python -m app.db_setup --reset`.
SEED_ON_START=true

# --- Tests (optional) ---
# By default the DB tests use a throwaway SQLite file. To run them on PostgreSQL instead, create a
# database whose name contains "test" and export this variable in your shell (it is read from the
# environment, not from this file). The test fixtures DROP all tables in that database.
# TEST_DATABASE_URL=postgresql://rental:rental@localhost:5432/rental_desk_test
