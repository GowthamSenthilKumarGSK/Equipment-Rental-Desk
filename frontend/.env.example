# Base URL of the backend API (no trailing slash). Baked in at build time by Vite.
VITE_API_URL=http://localhost:8000

# Reviewer test clock. Leave this unset (or "false") for any normal build.
# Set to "true" only to show a clearly labelled panel that sends the
# X-Test-Clock header; the API also has to run with ALLOW_TEST_CLOCK=true.
# VITE_ENABLE_TEST_CLOCK=false
